# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Virtual environments ---
.venv/
venv/
env/

# --- Env / secrets ---
.env
*.env.local

# --- Data (raw pulls + processed artifacts stay out of git; regenerate via ingestion scripts) ---
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Eval set IS tracked (hand-labeled, small, and it's the artifact worth showing) — do not ignore data/eval_set/

