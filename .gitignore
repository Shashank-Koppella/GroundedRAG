*.pt
*.bin
*.safetensors
models/
checkpoints/
lora_adapters/

# --- Vector DB / caches ---
qdrant_storage/
.groq_cache/
*.sqlite3
*.db

# --- Jupyter ---
.ipynb_checkpoints/

# --- OS / editor ---
.DS_Store
.vscode/*
